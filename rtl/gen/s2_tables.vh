    6'd38: s2_ref = {6'd39, 5'd7}; // O8.b <- N2
    6'd39: s2_ref = {6'd40, 5'd14}; // sa <- O2
    6'd40: s2_ref = {6'd41, 5'd15}; // sb <- O3
    6'd41: s2_ref = {6'd42, 5'd11}; // sc <- A3
    6'd42: s2_ref = {6'd43, 5'd17}; // sd <- O5
    6'd43: s2_ref = {6'd44, 5'd6}; // se <- N1
    6'd44: s2_ref = {6'd45, 5'd18}; // sf <- O6
    6'd45: s2_ref = {6'd46, 5'd20}; // sg <- O8
    6'd46: s2_ref = {6'd47, 5'd21}; // da <- Ra
    6'd47: s2_ref = {6'd48, 5'd22}; // db <- Rb
    6'd48: s2_ref = {6'd49, 5'd23}; // dc <- Rc
    6'd49: s2_ref = {6'd50, 5'd24}; // dd <- Rd
    6'd50: s2_ref = {6'd51, 5'd25}; // de <- Re
    6'd51: s2_ref = {6'd52, 5'd26}; // df <- Rf
    6'd52: s2_ref = {6'd53, 5'd27}; // dg <- Rg
    default: s2_ref = 11'd0;
  endcase
endfunction
function [6:0] s2_gold; input [2:0] k;
  case (k)
    3'd1: s2_gold = 7'b1001110; // C
    3'd2: s2_gold = 7'b1100111; // P
    3'd3: s2_gold = 7'b1001111; // E
    3'd4: s2_gold = 7'b0000001; // -
    3'd5: s2_gold = 7'b1111001; // 3
    3'd6: s2_gold = 7'b1111011; // 9
    default: s2_gold = 7'd0;
  endcase
endfunction
