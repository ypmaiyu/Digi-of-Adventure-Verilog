localparam [5:0] S3_NANIMALS_1 = 36;
localparam [5:0] S3_NANIMALS_2 = 23;
localparam [5:0] S3_NANIMALS_3 = 44;

// s3_skin(stage, species, k) = asset id of skin k (k wraps over the list)
function [7:0] s3_skin;
  input [1:0] st;
  input [1:0] sp;
  input [2:0] k;
  reg [2:0] n;
  begin
    case ({st, sp})
      {2'd1, 2'd0}: s3_skin = (k % 4 == 0) ? 8'd43 : (k % 4 == 1) ? 8'd44 : (k % 4 == 2) ? 8'd45 : 8'd46;   // snail_1.png, snail1_1.png, snail.png, snail1.png
      {2'd1, 2'd1}: s3_skin = (k % 2 == 0) ? 8'd47 : 8'd48;   // squirrel_1.png, squirrel.png
      {2'd1, 2'd2}: s3_skin = 8'd49;   // ant_1.png
      {2'd1, 2'd3}: s3_skin = (k % 2 == 0) ? 8'd56 : 8'd57;   // goose_2.png, goose.png
      {2'd2, 2'd0}: s3_skin = (k % 6 == 0) ? 8'd50 : (k % 6 == 1) ? 8'd51 : (k % 6 == 2) ? 8'd52 : (k % 6 == 3) ? 8'd53 : (k % 6 == 4) ? 8'd45 : 8'd46;   // snail_2.png, snail_22.png, snail1_2.png, snail1_22.png, snail.png, snail1.png
      {2'd2, 2'd1}: s3_skin = (k % 2 == 0) ? 8'd54 : 8'd48;   // squirrel_2.png, squirrel.png
      {2'd2, 2'd2}: s3_skin = 8'd55;   // ant_2.png
      {2'd2, 2'd3}: s3_skin = (k % 2 == 0) ? 8'd56 : 8'd57;   // goose_2.png, goose.png
      {2'd3, 2'd0}: s3_skin = (k % 4 == 0) ? 8'd58 : (k % 4 == 1) ? 8'd59 : (k % 4 == 2) ? 8'd45 : 8'd46;   // snail_3.png, snail1_3.png, snail.png, snail1.png
      {2'd3, 2'd1}: s3_skin = (k % 2 == 0) ? 8'd60 : 8'd48;   // squirrel_3.png, squirrel.png
      {2'd3, 2'd2}: s3_skin = 8'd61;   // ant_3.png
      {2'd3, 2'd3}: s3_skin = (k % 2 == 0) ? 8'd62 : 8'd57;   // goose_3.png, goose.png
      default: s3_skin = 8'd0;
    endcase
  end
endfunction
